# Manuscript Koala frontend config (Vite). VITE_* values are bundled into client JS and visible to anyone
# who loads the site -- never put a provider API key (Anthropic etc.) here.

# Base URL of the novel-editing-api backend (Cloud Run)
VITE_API_URL=https://novel-editing-api-3l3mbca7wa-uc.a.run.app

# Shared app token; must equal NOVEL_API_TOKEN on the backend (sent as X-App-Token). Set in Netlify env vars.
VITE_NOVEL_API_TOKEN=
